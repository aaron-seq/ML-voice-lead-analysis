# CallSense configuration.
# Copy to .env. Every value here has a working default — an empty file is fine
# for local development. See docs/CONFIGURATION.md for the full reference.

# ---------------------------------------------------------------- core ----
ENVIRONMENT=local                 # local | test | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=console                # use 'json' in production
# Loopback by default so a local run is not exposed to the network. Containers
# must bind all interfaces; the shipped Dockerfile passes --host 0.0.0.0.
# HOST=127.0.0.1
# PORT=8000

# ------------------------------------------------------------ database ----
# Default is SQLite in ./data — no server required.
# DATABASE_URL=postgresql+asyncpg://callsense:callsense@localhost:5432/callsense

# ------------------------------------------------------------- storage ----
STORAGE_BACKEND=local             # local | s3
# S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# Credentials come from the standard AWS provider chain (instance role,
# ~/.aws/credentials, or AWS_* env vars). Never set access keys here.

# ------------------------------------------------------------ security ----
# Auth is off by default for local development and FORCED ON in
# staging/production. Generate a key: python -m app.cli.main keygen
AUTH_ENABLED=false
# API_KEYS=cs_your_generated_key:admin
# Note: there is no SECRET_KEY. Auth compares API keys as SHA-256 digests --
# nothing is signed, so no signing secret exists to configure.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Starlette does not support globs in CORS_ORIGINS. For preview deployments:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_BYTES=26214400         # 25 MB

# -------------------------------------------------------------- engine ----
# The default lexicon analyzer needs no model download and is deterministic.
# Enabling this requires: pip install -r requirements-ml.txt
ENABLE_TRANSFORMER_SENTIMENT=false
# The SST-2-trained classifier. Off by default because it is measurably better
# on SST-2 and slightly worse on sales language — see docs/ML.md. Requires
# requirements-ml.txt and a model built with `python -m app.cli.main train`.
ENABLE_TRAINED_SENTIMENT=false

# ------------------------------------------------------- observability ----
# Prometheus metrics at /metrics. Values are per-worker; see docs/OPERATIONS.md.
METRICS_ENABLED=true
