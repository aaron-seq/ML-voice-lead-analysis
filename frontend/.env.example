# CallSense dashboard configuration.
# Copy to .env.local. Both values have working defaults for local development.
#
# These are the only two variables the dashboard reads. Everything else that
# used to be listed here (feature flags, analytics ids, NextAuth secrets,
# platform-detection variables) referred to a previous version of this project
# and was read by nothing.

# Where the browser reaches the API. Baked into the client bundle at build
# time, so it must be resolvable from the user's machine — not from inside a
# Docker network.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only needed when the API runs with AUTH_ENABLED=true.
#
# WARNING: NEXT_PUBLIC_* values are compiled into the JavaScript served to
# every visitor, so this key is readable by anyone who can load the dashboard.
# It is only appropriate for a deployment already behind a VPN or an
# authenticating proxy. Mint it with the narrowest role that works:
#     python -m app.cli.main keygen --role viewer
# NEXT_PUBLIC_API_KEY=
